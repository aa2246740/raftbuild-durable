{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["node"],
    "erasableSyntaxOnly": false
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts", "examples/**/*.ts"]
}
